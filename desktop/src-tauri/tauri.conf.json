{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ChatGPT To Codex",
  "version": "0.1.0",
  "identifier": "io.github.nanocode00.chatgpt2codex.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{
      "label": "main",
      "title": "ChatGPT To Codex",
      "width": 1120,
      "height": 760,
      "minWidth": 870,
      "minHeight": 580,
      "backgroundColor": "#171717"
    }],
    "security": { "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost" }
  },
  "bundle": { "active": false }
}
